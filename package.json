{
  "name": "under-the-green-light",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run tools/dev.ts",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "bun --watch server/index.ts",
    "build": "vite build",
    "start": "bun server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "bun test tests",
    "verify": "bun run check && bun test && bun run build"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fortawesome/fontawesome-common-types": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "qrcode": "^1.5.4",
    "svelte": "^5.46.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.3.5",
    "@types/qrcode": "^1.5.6",
    "svelte-check": "^4.3.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
