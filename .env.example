# docker compose reads this file after copying it to .env
APP_PORT=3000
# If using a reverse proxy, set the browser-visible origin, e.g. https://game.example.com
PUBLIC_ORIGIN=
# Automatically deployed GHCR image; use a sha-<full-commit> tag to pin a release
APP_IMAGE=ghcr.io/jamesflare1212/engr-4010-under-the-green-light:latest
WATCHTOWER_POLL_INTERVAL=60
# Optional: set a unique project name for multiple deployments; keep existing names when upgrading
# COMPOSE_PROJECT_NAME=engr-4010-under-the-green-light
# Direct Bun startup also accepts PORT and DATABASE_PATH; defaults are 3000 and ./data/green-light.sqlite
